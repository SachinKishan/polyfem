double min_angle(const polyfem::mesh::Mesh &mesh)
{
	const int dim = mesh.dimension();
	double result = std::numeric_limits<double>::infinity();

	for (int e = 0; e < mesh.n_elements(); ++e)
	{
		Eigen::Vector3d p[4];
		for (int i = 0; i <= dim; ++i)
		{
			p[i].setZero();
			p[i].head(dim) = mesh.point(mesh.element_vertex(e, i)).transpose();
		}

		const int tris[4][3] = {{0, 1, 2}, {0, 1, 3}, {0, 2, 3}, {1, 2, 3}};
		const int n_tris = (dim == 2) ? 1 : 4;
		for (int t = 0; t < n_tris; ++t)
			for (int c = 0; c < 3; ++c)
			{
				const Eigen::Vector3d u = p[tris[t][(c + 1) % 3]] - p[tris[t][c]];
				const Eigen::Vector3d v = p[tris[t][(c + 2) % 3]] - p[tris[t][c]];
				const double angle = std::atan2(u.cross(v).norm(), u.dot(v)) * 180.0 / M_PI;
				result = std::min(result, angle);
			}
	}
	return result;
}

double max_angle(const polyfem::mesh::Mesh &mesh)
{
	const int dim = mesh.dimension();
	double result = -std::numeric_limits<double>::infinity();

	for (int e = 0; e < mesh.n_elements(); ++e)
	{
		Eigen::Vector3d p[4];
		for (int i = 0; i <= dim; ++i)
		{
			p[i].setZero();
			p[i].head(dim) = mesh.point(mesh.element_vertex(e, i)).transpose();
		}

		const int tris[4][3] = {{0, 1, 2}, {0, 1, 3}, {0, 2, 3}, {1, 2, 3}};
		const int n_tris = (dim == 2) ? 1 : 4;
		for (int t = 0; t < n_tris; ++t)
			for (int c = 0; c < 3; ++c)
			{
				const Eigen::Vector3d u = p[tris[t][(c + 1) % 3]] - p[tris[t][c]];
				const Eigen::Vector3d v = p[tris[t][(c + 2) % 3]] - p[tris[t][c]];
				const double angle = std::atan2(u.cross(v).norm(), u.dot(v)) * 180.0 / M_PI;
				result = std::max(result, angle);
			}
	}
	return result;
}


void dump_mesh_vtu(mesh::NCMesh2D *nc, const std::string &path)
{
	nc->prepare_mesh();

	Eigen::MatrixXd V(nc->n_vertices(), 2);
	for (int i = 0; i < nc->n_vertices(); ++i)
		V.row(i) = nc->point(i);

	Eigen::MatrixXi F(nc->n_faces(), 3);
	for (int f = 0; f < nc->n_faces(); ++f)
		for (int lv = 0; lv < 3; ++lv)
			F(f, lv) = nc->face_vertex(f, lv);

	paraviewo::VTUWriter writer;
	writer.write_mesh(path, V, F, paraviewo::CellType::Triangle);
	std::cout<<"wrote debug mesh to "<<path<<std::endl;

}

void dump_mesh_vtu(mesh::NCMesh3D *nc, const std::string &path)
{
	nc->prepare_mesh();

	Eigen::MatrixXd V(nc->n_vertices(), 3);
	for (int i = 0; i < nc->n_vertices(); ++i)
		V.row(i) = nc->point(i);

	Eigen::MatrixXi F(nc->n_cells(), 4);
	for (int c = 0; c < nc->n_cells(); ++c)
		for (int lv = 0; lv < 4; ++lv)
			F(c, lv) = nc->cell_vertex(c, lv);

	paraviewo::VTUWriter writer;
	writer.write_mesh(path, V, F, paraviewo::CellType::Tetrahedron);
	std::cout << "wrote debug mesh to " << path << std::endl;
}

void dump_mesh_vtu(const mesh::Mesh *m, const std::string &path)
{
	Eigen::MatrixXd V(m->n_vertices(), 2);
	for (int i = 0; i < m->n_vertices(); ++i)
		V.row(i) = m->point(i);

	Eigen::MatrixXi F(m->n_faces(), 3);
	for (int f = 0; f < m->n_faces(); ++f)
		for (int lv = 0; lv < 3; ++lv)
			F(f, lv) = m->face_vertex(f, lv);

	paraviewo::VTUWriter writer;
	writer.write_mesh(path, V, F, paraviewo::CellType::Triangle);
	std::cout << "wrote debug mesh to " << path << std::endl;
}

