	void refinement_test_nonuniform(const json &base_args, const int p, const int number_of_refinements)
{
    json args = base_args;
    args["space"]["discr_order"] = p;

    State state;
    state.init(args, /*strict_validation=*/true);

    const std::string debug_dir = "/tmp/mesh_visual_itr_debug/";
    std::filesystem::create_directories(debug_dir);
    state.load_mesh(/*non_conforming=*/true);

    Units units;
    units.init(state.args["units"]);
    std::unique_ptr<mesh::Mesh> m = mesh::read_fem_geometry(
        units, state.args["geometry"], state.args["root_path"],
        {}, {}, {}, /*non_conforming=*/true);

    auto *nc = dynamic_cast<mesh::NCMesh3D *>(m.get());
    if (!nc)
        log_and_throw_error("Expected an NCMesh3D (3D tet mesh).");

    // base mesh refinement (uniform)
    nc->refine(kBaseRefs, 0.5);
    nc->prepare_mesh(); // refine_elements below needs up-to-date valid-element index maps

    // refine every element that has at least one vertex on the negative side of this plane
    const Eigen::RowVector3d plane_pos(0.25, 0, 0);
    Eigen::RowVector3d plane_normal(1, 0, 0);
    plane_normal.normalize();

    const std::string csv_path = debug_dir + "angles_nonuniform_p" + std::to_string(p) + ".csv";
    std::ofstream csv(csv_path);
    csv.precision(17);
    csv << "iteration,n_elements,min_angle,max_angle\n";

    auto record = [&](const int iteration) {
        const double min_a = min_angle(*nc);
        const double max_a = max_angle(*nc);
        csv << iteration << "," << nc->n_cells() << "," << min_a << "," << max_a << "\n";
        std::cout << "iter " << iteration << ": cells " << nc->n_cells()
                  << ", min angle " << min_a << ", max angle " << max_a << std::endl;
    };

    record(0);

    std::vector<int> ids;
    for (int i = 1; i <= number_of_refinements; ++i)
    {
        ids.clear();
        for (int c = 0; c < nc->n_cells(); ++c)
        {
            for (int lv = 0; lv < 4; ++lv)
            {
                const Eigen::RowVector3d pt = nc->point(nc->cell_vertex(c, lv));
                if ((pt - plane_pos).dot(plane_normal) < 0)
                {
                    ids.push_back(c);
                    break;
                }
            }
        }

        nc->refine_elements(ids);
        nc->prepare_mesh();
        record(i);
    }
    csv.close();

    dump_mesh_vtu(nc, debug_dir + "nur_test_" + std::to_string(number_of_refinements) + ".vtu");
}











	Result run_one_conforming(const json &base_args, const int p, const int level,
				const std::string &out_dir)
	{
		json args = base_args;
		args["space"]["discr_order"] = p;
		args["geometry"]["n_refs"] = kBaseRefs + level;
		args["/output/directory"_json_pointer] = "/tmp/solutions";
		args["output"]["paraview"]["file_name"] = "sol_c_L_" + std::to_string(level) + ".vtu";
		//args["output"]["paraview"]["vismesh_rel_area"] = 1e-5;

		std::filesystem::create_directories("/tmp/solutions");   // match the path used above
		std::filesystem::create_directories(out_dir);             // for the debug mesh dump below

		State state;
		state.init(args, /*strict_validation=*/true);
		state.load_mesh(/*non_conforming=*/false);

		Eigen::MatrixXd sol;
		state.solve(sol);

		dump_mesh_vtu(state.variational_formulation->output_space().mesh,
			 out_dir + "/mesh_conforming_L" + std::to_string(level) + ".vtu");

		state.variational_formulation->export_data(sol);
		std::cout << "export_data returned, expected file at: /tmp/solutions/sol_c_L_0.vtu, exists="
				  << std::filesystem::exists("/tmp/solutions/sol_c_L_0.vtu") << std::endl;

		const io::OutStatsData stats = state.variational_formulation->compute_errors(sol);
		return {level, stats.mesh_size, stats.l2_err, stats.h1_semi_err};
	}






	void print_table(const std::string &label, const int p, const std::vector<Result> &rs,
					  std::ostream &out = std::cout)
	{
		out << "\n== " << label << ", p = " << p
			<< "  (expect L2 rate ~" << p + 1 << ", H1-semi rate ~" << p << ")\n";
		out << std::setw(5) << "lvl" << std::setw(13) << "h"
			<< std::setw(13) << "L2" << std::setw(8) << "rate"
			<< std::setw(13) << "H1semi" << std::setw(8) << "rate" << "\n";

		for (size_t i = 0; i < rs.size(); ++i)
		{
			out << std::setw(5) << rs[i].level
				<< std::setw(13) << std::scientific << std::setprecision(3) << rs[i].h
				<< std::setw(13) << rs[i].l2;
			if (i == 0)
				out << std::setw(8) << "-";
			else
				out << std::setw(8) << std::fixed << std::setprecision(2)
					<< std::log(rs[i - 1].l2 / rs[i].l2) / std::log(rs[i - 1].h / rs[i].h);

			out << std::setw(13) << std::scientific << std::setprecision(3) << rs[i].h1s;
			if (i == 0)
				out << std::setw(8) << "-";
			else
				out << std::setw(8) << std::fixed << std::setprecision(2)
					<< std::log(rs[i - 1].h1s / rs[i].h1s) / std::log(rs[i - 1].h / rs[i].h);
			out << "\n";
		}
	}

