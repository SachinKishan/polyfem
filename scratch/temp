	// Uniform levels applied to the 2-triangle square before anything else,
	// so the non-uniform step has more than two elements to work with.
	constexpr int kBaseRefs = 1;

	struct Result
	{
		int level;
		double h;   // hmax (max edge length), from OutStatsData::mesh_size
		double l2;  // O(h^{p+1})
		double h1s; // O(h^p)
	};

	Result run_one(const json &base_args, const int p, const int level,
				   const bool nonuniform, const std::string &out_dir)
	{
		json args = base_args;
		args["space"]["discr_order"] = p;
		//args["/output/directory"_json_pointer] = "/tmp/solutions";
		args["output"]["paraview"]["file_name"] = "sol_nc_L_" + std::to_string(level) + ".vtu";
		//args["output"]["paraview"]["vismesh_rel_area"] = 1e-5; // smaller = finer sampling, default is usually fine

		State state;
		state.init(args, /*strict_validation=*/true);

		const std::string debug_dir = "/tmp/mesh_visual_itr_debug/";

		// Pushes the validated/adjusted args into the varform and loads a mesh.
		// That mesh is replaced below; set_mesh is public, and bases/assembly
		// are built lazily inside solve(), so replacing it here is safe.
		state.load_mesh(/*non_conforming=*/true);

		Units units;
		units.init(state.args["units"]);
		std::unique_ptr<mesh::Mesh> m = mesh::read_fem_geometry(
			units, state.args["geometry"], state.args["root_path"],
			{}, {}, {}, /*non_conforming=*/true);

		auto *nc = dynamic_cast<mesh::NCMesh2D *>(m.get());
		if (!nc)
			log_and_throw_error("Expected an NCMesh2D (2D triangle mesh).");



		//base mesh refinement
		nc->refine(kBaseRefs, 0.5);

		dump_mesh_vtu(nc, debug_dir + "nc_before_nonuniform_refinement_" + std::to_string(level) + ".vtu");

		if (nonuniform)
		{
			// Two passes -> leaf levels 0 / 1 / 2 across the domain.
			// prepare_mesh() is needed before refine_elements() because it
			// builds the valid->all element id maps that refine_elements uses.
			for (const double xcut : {0.5})
			{
				nc->prepare_mesh();
				std::vector<int> ids;
				for (int f = 0; f < nc->n_faces(); ++f)
					if (nc->face_barycenter(f)(0) < xcut)
						ids.push_back(f);
				nc->refine_elements(ids);
			}
		}
		nc->prepare_mesh();
		dump_mesh_vtu(nc, debug_dir + "nc_after_nonuniform_refinement_" + std::to_string(level) + ".vtu");


		//additional refinement
		dump_mesh_vtu(nc, debug_dir + "nc_before_uniform_refinement_" + std::to_string(level) + ".vtu");
		nc->refine(level,0.5);
		dump_mesh_vtu(nc, debug_dir + "nc_after_uniform_refinement_" + std::to_string(level) + ".vtu");

		nc->prepare_mesh();


		state.variational_formulation->set_mesh(std::move(m));

		Eigen::MatrixXd sol;
		state.solve(sol);

		state.variational_formulation->export_data(sol);

		const io::OutStatsData stats = state.variational_formulation->compute_errors(sol);
		return {level, stats.mesh_size, stats.l2_err, stats.h1_semi_err};
	}

